# Copy to backend/.env and fill in. That file is gitignored.
#
# Without this the tracker runs exactly as before: the assistant is off,
# the /ai routes answer 503, and nothing leaves the machine.
ANTHROPIC_API_KEY=

# Optional overrides.
# PP_AI_FAST_MODEL=claude-haiku-4-5-20251001
# PP_AI_MODEL=claude-sonnet-5

# Whose repos the personal side lists. Without it, the owner is taken
# from a repo already mapped to a project.
# PP_GITHUB_USER=your-github-login

# Needed only for private repos -- and to list them on the personal side.
# GITHUB_TOKEN=

# --- Power BI -------------------------------------------------------
# Reports and their refresh state. Without these, linking a report by
# URL still works; only the refresh status is unavailable.
#
# A service principal, created in Azure AD and allowed in the Power BI
# admin portal. It must be added to each workspace you want read.
# PBI_TENANT_ID=
# PBI_CLIENT_ID=
# PBI_CLIENT_SECRET=
#
# Or paste a token from the Power BI developer tools to try it out.
# It expires in about an hour.
# PBI_ACCESS_TOKEN=
